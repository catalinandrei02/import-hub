{
  "manifest_version": 3,
  "name": "Import Hub",
  "version": "1.2.0",
  "description": "Fetches car photos and details from listing links for the family's Import Hub site.",
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://catalinandrei02.github.io/import-hub/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }]
}
