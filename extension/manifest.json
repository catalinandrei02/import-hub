{
  "manifest_version": 3,
  "name": "Import Hub",
  "version": "1.4.0",
  "description": "Reads car listings and searches for the family's Import Hub site, in this Chrome.",
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://catalinandrei02.github.io/import-hub/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }]
}
